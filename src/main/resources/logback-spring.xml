<?xml version="1.0" encoding="UTF-8"?>
<!-- 환경별 콘솔 로그 형식과 요청 추적 ID 표시를 설정합니다. -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="CONSOLE_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} [%thread] [%X{traceId:-no-trace}] %-5level %logger{36} - %msg%n"/>

    <!-- 로컬과 테스트에서는 색상을 사용해 로그 수준과 요청 ID를 쉽게 구분합니다. -->
    <springProfile name="local,test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%clr(%d{HH:mm:ss.SSS}){faint} %clr([%X{traceId:-no-trace}]){cyan} %clr(%-5level){highlight} %clr(%logger{36}){magenta} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- 운영에서는 수집하기 쉬운 일반 텍스트 로그를 표준 출력으로 보냅니다. -->
    <springProfile name="prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${CONSOLE_PATTERN}</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
