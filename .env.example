POSTGRES_DB=stockdrop
POSTGRES_USER=account
POSTGRES_PASSWORD=account-local-password
POSTGRES_PORT=5433

# IDE에서 Account를 실행하고 Eureka를 localhost:8761에서 실행하는 로컬 기본값입니다.
EUREKA_CLIENT_ENABLED=true
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
# 운영: 위 URL을 Eureka A/B 두 주소(쉼표 구분)로 바꾸고 아래 세 값도 필수로 주입합니다.
# SERVICE_HOSTNAME=10.0.1.10
# SERVICE_INSTANCE_ID=account-a
# SERVICE_PORT=8080

DB_URL=jdbc:postgresql://localhost:5433/stockdrop
DB_USERNAME=account
DB_PASSWORD=account-local-password

# 프로젝트 루트의 .env에 복사합니다. Spring과 Compose가 같은 파일을 읽습니다.
# IntelliJ Working directory는 프로젝트 루트로 설정합니다.
SPRING_PROFILES_ACTIVE=local,gmail
MAIL_USERNAME=your-account@gmail.com
# 일반 로그인 비밀번호 대신 16자리 앱 비밀번호를 공백·따옴표 없이 입력합니다.
MAIL_PASSWORD=

# 로컬 Docker S3Mock 주소이며 실제 AWS 키가 필요하지 않습니다.
# SELLER_S3_ENDPOINT=http://localhost:9090
# 운영 A/B는 동일한 32바이트 키를 Base64로 주입합니다. 로컬은 .keys에 자동 생성합니다.
# SELLER_DATA_ENCRYPTION_KEY=
# SELLER_CERTIFICATE_BUCKET=your-private-bucket
# 최초 운영자 지정 시에만 설정하고 지정 후 제거합니다.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com

# JWT 공개 발급자 주소와 프론트의 정확한 Origin 목록입니다.
JWT_ISSUER=http://localhost:8080
APP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# 운영에서는 A/B가 공유하는 비밀 서명 키 JWK 파일을 마운트하여 지정합니다.
# JWT_SIGNING_KEY_LOCATION=file:/run/secrets/account-signing.jwk

# 외부 메일 없이 Mailpit만 쓰려면 SPRING_PROFILES_ACTIVE=local로 바꿉니다.
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_FROM=no-reply@stockdrop.local
