POSTGRES_DB=stockdrop
POSTGRES_USER=account
POSTGRES_PASSWORD=account-local-password
POSTGRES_PORT=5433

DB_URL=jdbc:postgresql://localhost:5433/stockdrop
DB_USERNAME=account
DB_PASSWORD=account-local-password

# 프로젝트 루트의 .env에 복사합니다. Spring과 Compose가 같은 파일을 읽습니다.
# IntelliJ Working directory는 프로젝트 루트로 설정합니다.
SPRING_PROFILES_ACTIVE=local,gmail
MAIL_USERNAME=your-account@gmail.com
# 일반 로그인 비밀번호 대신 16자리 앱 비밀번호를 공백·따옴표 없이 입력합니다.
MAIL_PASSWORD=

# 외부 메일 없이 Mailpit만 쓰려면 SPRING_PROFILES_ACTIVE=local로 바꿉니다.
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_FROM=no-reply@stockdrop.local
